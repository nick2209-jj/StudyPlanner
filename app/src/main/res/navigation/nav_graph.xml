<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.studyplanner.HomeFragment"
        android:label="Home" />

    <fragment
        android:id="@+id/tasksFragment"
        android:name="com.example.studyplanner.TasksFragment"
        android:label="Tasks" />

    <fragment
        android:id="@+id/scheduleFragment"
        android:name="com.example.studyplanner.ScheduleFragment"
        android:label="Schedule" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.studyplanner.SettingsFragment"
        android:label="Settings" />

    <fragment
        android:id="@+id/subjectsFragment"
        android:name="com.example.studyplanner.SubjectsFragment"
        android:label="Subjects" />

    <fragment
        android:id="@+id/freeTimeFragment"
        android:name="com.example.studyplanner.FreeTimeFragment"
        android:label="Available study time" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.studyplanner.ProfileFragment"
        android:label="@string/profile_title">
        <argument
            android:name="editMode"
            android:defaultValue="false"
            app:argType="boolean" />
    </fragment>

</navigation>